# Production configuration — use hosting-provider environment variables, never committed files.
# Copy to .env.local for local development only. .env.local is ignored by Git.

# Public Dynamic SDK identifier. It is intentionally exposed to the browser through /api/public-config.
DYNAMIC_ENVIRONMENT_ID=

# Server-side Supabase REST configuration. The URL is public, but the key is not.
SUPABASE_URL=
# Preferred on new Supabase projects. This is the SERVER-ONLY secret.
# Rotate the previously exposed key, then paste the new value into Render's
# encrypted Variables panel. Never commit it, never send it in chat.
SUPABASE_SECRET_KEY=
# Legacy projects only. The server accepts either name, but prefer SUPABASE_SECRET_KEY.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: only needed if a future browser Supabase client is added.
# SUPABASE_ANON_KEY=
# SUPABASE_PUBLISHABLE_KEY=

# Mainnet controls (USDC six-decimal minor units)
MAX_MAINNET_USDC_MINOR=25000000
MAX_DAILY_MAINNET_USDC_MINOR=100000000

# Payment execution (server-only). Relay requires the API key on POST /quote/v2 from 2 October 2026.
# Never send it to the browser, commit it, or paste it into chat.
RELAY_API_KEY=
# Optional Monad JSON-RPC for settlement verification. Defaults to https://rpc.monad.xyz (chain 143).
# MONAD_RPC_URL=https://rpc.monad.xyz
