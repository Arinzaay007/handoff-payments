# Production configuration — use hosting-provider environment variables, never committed files.

# Public Dynamic SDK identifier. It is intentionally exposed to the browser through /api/public-config.
DYNAMIC_ENVIRONMENT_ID=

# Server-side Supabase REST configuration. The URL is public, but the key is not.
SUPABASE_URL=
# Use one of these based on your Supabase project. Never expose either secret/service key in browser code.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# Optional: only needed if a future browser Supabase client is added.
# SUPABASE_ANON_KEY=
# SUPABASE_PUBLISHABLE_KEY=

# Mainnet controls (USDC six-decimal minor units)
MAX_MAINNET_USDC_MINOR=25000000
MAX_DAILY_MAINNET_USDC_MINOR=100000000
