{
  "name": "handoff-omnichain-payments",
  "version": "0.1.0",
  "private": true,
  "description": "Handoff — one handle, any supported chain, settled on Monad.",
  "scripts": {
    "start": "node server.js",
    "build:dynamic": "esbuild src/dynamic-client.js --bundle --platform=browser --format=iife --global-name=HandoffDynamicBundle --define:process.env.NODE_ENV='\"production\"' --minify --outfile=public/dynamic-client.js",
    "build": "npm run build:dynamic",
    "test": "node --test test/*.test.js",
    "release:check": "bash scripts/release-production.sh --check"
  },
  "dependencies": {
    "@dynamic-labs/sdk-react-core": "^5.10.0",
    "@dynamic-labs/waas-evm": "^5.10.0",
    "@relay-protocol/settlement-sdk": "^0.0.146",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "2.57.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0"
  }
}
